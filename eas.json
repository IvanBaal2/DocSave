{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "DOCSAVE_PROFILE": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "DOCSAVE_PROFILE": "production"
      },
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "local"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "DOCSAVE_PROFILE": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
